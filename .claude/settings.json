{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/block_git_add_all.sh",
            "if": "Bash(git *)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/stop_gate.sh",
            "timeout": 300,
            "statusMessage": "Running quality gates..."
          }
        ]
      }
    ]
  }
}
